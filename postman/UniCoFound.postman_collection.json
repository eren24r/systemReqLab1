{
  "info": {
    "name": "UniCoFound API",
    "description": "End-to-end check of the UniCoFound monolith. Run requests top to bottom: ids are stored in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "studentId", "value": "" },
    { "key": "student2Id", "value": "" },
    { "key": "investorId", "value": "" },
    { "key": "investor2Id", "value": "" },
    { "key": "skillId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "joinRequestId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "offer2Id", "value": "" },
    { "key": "suffix", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('suffix')) {",
          "    pm.collectionVariables.set('suffix', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Users",
      "item": [
        {
          "name": "Create student (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('studentId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice.{{suffix}}@itmo.ru\",\n  \"fullName\": \"Alice Founder\",\n  \"role\": \"STUDENT\",\n  \"bio\": \"Backend developer, wants to build an EdTech startup\"\n}" }
          }
        },
        {
          "name": "Create second student (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('student2Id', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"bob.{{suffix}}@itmo.ru\",\n  \"fullName\": \"Bob Designer\",\n  \"role\": \"STUDENT\",\n  \"bio\": \"UI/UX designer\"\n}" }
          }
        },
        {
          "name": "Create investor (201)",
