          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"investor.{{suffix}}@fund.com\",\n  \"fullName\": \"Ivan Investor\",\n  \"role\": \"INVESTOR\"\n}" }
          }
