            "    pm.expect(pm.response.json().details).to.have.property('email');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\",\n  \"fullName\": \"\",\n  \"role\": null\n}" }
          }
        },
        {
          "name": "Create user - duplicate email (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ALICE.{{suffix}}@itmo.ru\",\n  \"fullName\": \"Alice Clone\",\n  \"role\": \"STUDENT\"\n}" }
          }
        },
        {
          "name": "Get user (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{studentId}}" }
        },
        {
          "name": "Get user - not found (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/999999" }
        },
        {
          "name": "List users with X-Total-Count (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK with total count header', () => {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.headers.has('X-Total-Count')).to.be.true;",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?page=0&size=2" }
        },
        {
          "name": "List users - size above 50 (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?page=0&size=51" }
        },
        {
          "name": "Update user (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users/{{studentId}}",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Alice Founder-Smith\",\n  \"role\": \"STUDENT\",\n  \"bio\": \"Updated bio\"\n}" }
          }
        },
        {
          "name": "Add seeded skill Java to user (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK, skill attached', () => {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().skills.length).to.be.above(0);",
            "});"
          ] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/users/{{studentId}}/skills/1" }
        },
        {
          "name": "Add same skill again (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
          ] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/users/{{studentId}}/skills/1" }
        },
        {
          "name": "Remove skill from user (200)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));"
          ] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{studentId}}/skills/1" }
        }
      ]
    },
