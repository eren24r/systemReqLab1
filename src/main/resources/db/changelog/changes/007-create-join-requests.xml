<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-join-requests" author="unicofound">
        <createTable tableName="join_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_join_requests" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="applicant_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="desired_role" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT"/>
            <column name="status" type="VARCHAR(32)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="resolved_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="join_requests" baseColumnNames="project_id"
                                 referencedTableName="projects" referencedColumnNames="id"
                                 constraintName="fk_join_requests_project" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="join_requests" baseColumnNames="applicant_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_join_requests_applicant" onDelete="CASCADE"/>
        <createIndex tableName="join_requests" indexName="idx_join_requests_project">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="join_requests" indexName="idx_join_requests_applicant">
            <column name="applicant_id"/>
        </createIndex>
        <sql>ALTER TABLE join_requests ADD CONSTRAINT chk_join_requests_role CHECK (desired_role IN ('FOUNDER', 'DEVELOPER', 'DESIGNER', 'MARKETER', 'ANALYST', 'OTHER'))</sql>
        <sql>ALTER TABLE join_requests ADD CONSTRAINT chk_join_requests_status CHECK (status IN ('PENDING', 'ACCEPTED', 'REJECTED'))</sql>
    </changeSet>

</databaseChangeLog>
