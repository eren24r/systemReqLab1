<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-create-investment-offers" author="unicofound">
        <createTable tableName="investment_offers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_investment_offers" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="investor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="equity_percent" type="NUMERIC(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT"/>
            <column name="status" type="VARCHAR(32)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="resolved_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="investment_offers" baseColumnNames="project_id"
                                 referencedTableName="projects" referencedColumnNames="id"
                                 constraintName="fk_investment_offers_project" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="investment_offers" baseColumnNames="investor_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_investment_offers_investor" onDelete="CASCADE"/>
        <createIndex tableName="investment_offers" indexName="idx_investment_offers_project">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="investment_offers" indexName="idx_investment_offers_investor">
            <column name="investor_id"/>
        </createIndex>
        <sql>ALTER TABLE investment_offers ADD CONSTRAINT chk_investment_offers_status CHECK (status IN ('PENDING', 'ACCEPTED', 'REJECTED', 'WITHDRAWN'))</sql>
        <sql>ALTER TABLE investment_offers ADD CONSTRAINT chk_investment_offers_amount CHECK (amount > 0)</sql>
        <sql>ALTER TABLE investment_offers ADD CONSTRAINT chk_investment_offers_equity CHECK (equity_percent > 0 AND equity_percent &lt;= 100)</sql>
    </changeSet>

</databaseChangeLog>
